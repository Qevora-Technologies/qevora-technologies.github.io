---
import { Mail, MapPin } from 'lucide-react';
import SectionHeading from '@/components/SectionHeading.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const field = 'w-full rounded-xl border border-border bg-bg px-4 py-3 text-fg placeholder:text-muted/70 focus:border-fg focus:outline-none';
---

<section id="contact" class="bg-surface px-4 py-24 sm:px-6 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading
      eyebrow="Contact"
      title="Tell us what you're building"
      intro="Share a few details and we'll get back to you within one business day with next steps and a free quote."
    />

    <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr]">
      <!-- Contact details — mint panel -->
      <aside data-reveal class="flex flex-col justify-between gap-10 rounded-2xl bg-mint p-8 text-mint-ink sm:p-10">
        <div>
          <h3 class="font-display text-2xl font-bold">Prefer to talk directly?</h3>
          <p class="mt-3 text-mint-ink/80">Email us anytime — a real person on the team will reply.</p>
          <ul class="mt-8 space-y-5">
            <li class="flex items-start gap-3">
              <Mail size={20} strokeWidth={1.75} className="mt-0.5 shrink-0" aria-hidden="true" />
              <a href={`mailto:${site.email}`} class="font-medium break-all underline-offset-4 hover:underline">{site.email}</a>
            </li>
            <li class="flex items-start gap-3">
              <MapPin size={20} strokeWidth={1.75} className="mt-0.5 shrink-0" aria-hidden="true" />
              <span class="font-medium">{site.location}</span>
            </li>
          </ul>
        </div>
        <ul class="flex flex-wrap gap-3">
          {site.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="inline-flex rounded-full border border-mint-ink/25 px-4 py-2 text-sm font-medium transition-colors hover:bg-mint-ink hover:text-mint">{s.label} ↗</a></li>
          ))}
        </ul>
      </aside>

      <!-- Quote form -->
      <form id="contact-form" data-reveal data-key={web3formsKey} data-email={site.email} class="rounded-2xl border border-border bg-bg p-8 sm:p-10" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="mb-2 block text-sm font-medium">Name</span>
            <input name="name" required autocomplete="name" class={field} placeholder="Your name" />
          </label>
          <label class="block">
            <span class="mb-2 block text-sm font-medium">Email</span>
            <input name="email" type="email" required autocomplete="email" class={field} placeholder="you@startup.com" />
          </label>
          <label class="block">
            <span class="mb-2 block text-sm font-medium">Company <span class="text-muted">(optional)</span></span>
            <input name="company" autocomplete="organization" class={field} placeholder="Startup name" />
          </label>
          <label class="block">
            <span class="mb-2 block text-sm font-medium">Service</span>
            <select name="service" class={field}>
              {services.map((s) => <option>{s.title}</option>)}
              <option>Not sure yet</option>
            </select>
          </label>
          <label class="block sm:col-span-2">
            <span class="mb-2 block text-sm font-medium">Project details</span>
            <textarea name="message" required rows="5" class={field} placeholder="What are you building, and when do you need it?"></textarea>
          </label>
        </div>
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p id="form-status" class="text-sm text-muted" role="status" aria-live="polite"></p>
          <div class="flex flex-wrap gap-3">
            <a href={site.projectFormUrl} target="_blank" rel="noopener" class="rounded-full border border-border px-7 py-3 font-medium transition-colors hover:border-fg">Fill project form ↗</a>
            <button type="submit" class="rounded-full bg-accent px-7 py-3 font-medium text-bg transition-colors hover:bg-accent-hover disabled:opacity-60">Get a free quote</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  function setup() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;
    const status = document.getElementById('form-status')!;
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const key = form.dataset.key;

      // No form service configured yet → open the visitor's email app, pre-filled.
      if (!key) {
        const body = `Name: ${data.name}\nEmail: ${data.email}\nCompany: ${data.company || '-'}\nService: ${data.service}\n\n${data.message}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Quote request — ${data.service}`)}&body=${encodeURIComponent(body)}`;
        status.textContent = 'Opening your email app…';
        return;
      }

      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, access_key: key, subject: `Quote request — ${data.service}`, from_name: 'QevoraTech website' }),
        });
        const json = await res.json();
        if (!json.success) throw new Error(json.message);
        form.reset();
        status.textContent = "Thanks! We'll reply within one business day.";
      } catch {
        status.textContent = `Something went wrong. Please email us at ${form.dataset.email}.`;
      } finally {
        button.disabled = false;
      }
    });
  }
  setup();
</script>
