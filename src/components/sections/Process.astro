---
import SectionHeading from '@/components/SectionHeading.astro';

const steps = [
  { title: 'Discovery call', text: 'A free 30-minute call to understand your idea, users and goals.' },
  { title: 'Proposal & quote', text: 'A clear plan with scope, timeline and a fixed price — usually within a few days.' },
  { title: 'Design & build', text: 'We work in short sprints and show you a working demo every week.' },
  { title: 'Launch & support', text: 'We ship to production, monitor it, and stay on hand to keep it running.' },
];
---

<section id="process" class="px-4 py-24 sm:px-6 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading eyebrow="How we work" title="From idea to launch in four steps" />
    <ol class="relative grid gap-8 md:grid-cols-4 md:gap-6">
      <span class="process-line absolute top-6 left-6 hidden h-px w-[calc(100%-3rem)] origin-left bg-fg/25 md:block" aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li data-reveal class="relative">
            <span class="relative grid size-12 place-items-center rounded-full border border-border bg-bg font-mono text-sm font-semibold">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-6 font-display text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '@/lib/motion';
  if (!prefersReducedMotion()) {
    gsap.from('.process-line', {
      scaleX: 0,
      ease: 'none',
      scrollTrigger: { trigger: '#process ol', start: 'top 80%', end: 'top 40%', scrub: true },
    });
  }
</script>
