---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg viewBox="0 0 28 36" class="h-7 w-auto" fill="none" aria-hidden="true">
    <rect x="0" y="2" width="4.5" height="32" rx="2.25" fill="currentColor"></rect>
    <circle cx="17" cy="9" r="6" stroke="currentColor" stroke-width="3.2"></circle>
    <path d="M18.5 10.5 L22.5 14.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
    <circle cx="17" cy="27" r="6" stroke="currentColor" stroke-width="3.2"></circle>
    <path d="M18.5 28.5 L22.5 32.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <span class="font-display text-xl font-bold tracking-tight">Qevora<span class="text-accent">Tech</span></span>
</span>
